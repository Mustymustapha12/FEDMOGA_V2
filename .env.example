# Add these in Hostinger's deployment Environment variables. Never commit real values.
APP_URL=https://your-fedmoga-domain.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# First deployment only. Password must be 12–128 characters, unique and private.
SUPER_ADMIN_EMAIL=mustymustapha12@gmail.com
SUPER_ADMIN_PASSWORD=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key permanently: changing it makes stored Paystack keys unreadable.
FEDMOGA_ENCRYPTION_KEY=
# Keep false while testing; live activation also requires working email and HTTPS.
ALLOW_LIVE_PAYMENTS=false
# Optional for initial test checkout, required before live activation.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: only if Hostinger confirms a local Unix socket is required.
# Leave unset for the normal DB_HOST/DB_PORT TCP connection.
# DB_SOCKET=/var/lib/mysql/mysql.sock

# V2 scheduler: generate a separate random secret (at least 32 characters).
JOB_SECRET=
